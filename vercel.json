{
  "version": 2,
  "installCommand": "corepack enable && corepack prepare pnpm@11.20.0 --activate && pnpm install",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "runtime": "@vercel/node@5.9.9" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
